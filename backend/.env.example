# Copier ce fichier en .env puis adapter les valeurs
PORT=3000
# Origine du front-end autorisée par CORS
CORS_ORIGIN=http://localhost:5173
# Nombre maximal de requêtes par IP sur 15 minutes
RATE_LIMIT_MAX=300
# En production derrière un reverse proxy (nginx) : nombre de proxys de confiance
# TRUST_PROXY=1
